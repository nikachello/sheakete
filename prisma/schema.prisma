generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}


datasource db {
  provider = "postgresql"
}


enum OrderType {
  LEAD
  ORDER
}

enum OrderStatus {
  // Lead Stages
  PENDING
  NO_ANSWER
  CANCELLED
  CONFIRMED
  
  // Order Stages
  RECEIVED
  SHIPPED
  PAID
  REFUNDED
}

model Order {
  id             String      @id @default(uuid())
  createdAt      DateTime    @default(now())
  customerName   String
  customerPhone  String
  productTitle   String?
  comboDetails   String?
  price          Float?
  
  type           OrderType   @default(LEAD)
  status         OrderStatus @default(PENDING)
  
  notes          String?

  actualPaidPrice String?
}
