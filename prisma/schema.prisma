generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma/client"
}


datasource db {
  provider  = "postgresql"
  url  	    = env("DATABASE_URL")
  // uncomment next line if you use Prisma <5.10
  // directUrl = env("DATABASE_URL_UNPOOLED")
}


enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
  RESERVATION        
  RESERVATION_RELEASE
}

enum OrderType {
  LEAD
  ORDER
}

enum OrderStatus {
  PENDING
  NO_ANSWER
  CANCELLED
  CONFIRMED
  SHIPPED
  DELIVERED
  RETURNED
}

enum PaymentStatus {
  AWAITING_COLLECTION
  COLLECTED
  SETTLED
  REFUNDED
}

enum ExpenseType {
  MARKETING
  SALARY
  RENT
  SOFTWARE
  LOGISTICS
  TAX
  OTHER
}

enum BankTransactionType {
  IN
  OUT
}

enum FounderLoanType {
  COMPANY_OWES_FOUNDER
  COMPANY_REPAID_FOUNDER
}

model Stock {
  id String @id @default(uuid())
  productId String @unique
  productTitle String

  quantityOnHand  Int      @default(0)
  quantityReserved Int     @default(0)

  quantity Int @default(0)

  averageCost     Float?
  lastPurchasePrice Float?

  reorderPoint    Int?
  reorderQuantity Int?

  updatedAt DateTime @updatedAt
  @@index([productId])
}

model StockMovement {
  id String @id @default(uuid())
  createdAt DateTime @default(now())
  productId String
  productTitle String
  quantity Int
  type StockMovementType
  orderId String?
  order Order? @relation(fields: [orderId], references: [id])
  notes String?

  isReservation Boolean          @default(false)
  unitCost     Float?
  totalCost    Float?

  @@unique([orderId, type])
  @@index([productId])
  @@index([type])
  @@index([createdAt])
}

model Order {
  id             String      @id @default(uuid())
  createdAt      DateTime    @default(now())
  updatedAt DateTime @updatedAt
  returnedAt DateTime? 
  customerName   String
  customerPhone  String
  city String?
  address String?
  productId String?
  productTitle   String?
  comboDetails   String?
  quantity Int @default(1)
  expectedPrice Float @default(0)
  cashCollected Float?
  actualPaidPrice Float?
  productCost Float @default(0)
  shippingFee Float @default(0)
  additionalCosts Float @default(0)
  type           OrderType   @default(LEAD)
  status         OrderStatus @default(PENDING)
  paymentStatus PaymentStatus @default(AWAITING_COLLECTION)
  notes          String?
  remittanceId String?
  remittance Remittance? @relation(fields: [remittanceId], references: [id])
  stockMoveemnts StockMovement[]
  @@index([status])
  @@index([type])
  @@index([paymentStatus])
}

model Remittance {
  id               String            @id @default(uuid())
  createdAt        DateTime          @default(now())
  totalAmount      Float
  bankReference    String?
  dateReceived     DateTime          @default(now())
  notes            String?
  orders           Order[]
  bankTransactions BankTransaction[] @relation(name: "RemittanceBankTransactions")
}



model Expense {
  id           String                   @id @default(uuid())
  createdAt    DateTime                 @default(now())
  type         ExpenseType
  amount       Float
  description  String?
  reference    String?
  month        Int
  year         Int
  isVirtual    Boolean                  @default(false)
  paidFromBank Boolean                  @default(false)
  bankTransaction BankTransaction?      @relation(name: "ExpenseBankTransaction")
  founderLoan     FounderLoanTransaction?

  @@index([type])
  @@index([month, year])
}

model BankTransaction {
  id           String                  @id @default(uuid())
  createdAt    DateTime                @default(now())
  amount       Float
  type         BankTransactionType
  remittanceId String?
  remittance   Remittance?             @relation(name: "RemittanceBankTransactions", fields: [remittanceId], references: [id])
  expenseId    String?                 @unique
  expense      Expense?                @relation(name: "ExpenseBankTransaction", fields: [expenseId], references: [id])
  founderLoan  FounderLoanTransaction?
  note         String?
}

model FounderLoanTransaction {
  id                String           @id @default(uuid())
  createdAt         DateTime         @default(now())
  amount            Float
  type              FounderLoanType
  expenseId         String?          @unique
  expense           Expense?         @relation(fields: [expenseId], references: [id])
  bankTransactionId String?          @unique
  bankTransaction   BankTransaction? @relation(fields: [bankTransactionId], references: [id])
  note              String?
}