# Copy these into your existing local/hosting environment. Never replace DATABASE_URL.
# Keep both flags false until migration, consent text, scheduler, and Meta tests are ready.
NEXT_PUBLIC_META_ENABLED=false
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_SITE_URL=
META_CAPI_ENABLED=false
META_CAPI_ACCESS_TOKEN=
# Set an explicitly supported version shown by Meta during setup, e.g. v25.0.
META_GRAPH_API_VERSION=
# Use only with Meta Test Events. Remove before real production reporting.
META_TEST_EVENT_CODE=
# Generate a separate long random secret for the retry scheduler.
CRON_SECRET=
# Enable ONLY if your hosting platform overwrites x-forwarded-for with a trusted client IP.
META_TRUST_PROXY_HEADERS=false
